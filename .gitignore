node_modules/
dist/
*.tsbuildinfo
.vite/
coverage/
# test artifacts
test-results/
playwright-report/
games/*/tests/artifacts/
apps/*/tests/artifacts/
blob-report/
# native platform folders (generated by `npx cap add`)
android/
ios/
# multi-game test APK output (tools/apk.mjs)
/build/
# misc
.DS_Store
*.log
games/*/.readme-check-*/
# signing keys never go into git; the one PUBLIC test-only key is the exception
# (tools/test-imza/README.md). Play upload keys live outside the repo.
*.keystore
*.jks
*.p12
!tools/test-imza/debug.keystore

# store listing metadata uses fastlane's "android" folder name: keep it tracked
!store/*/metadata/android/

# promo videos are release assets (GitHub release "tanitim-videolari"), not tracked: store/tools/video/README.md
store/*/video/*.mp4
